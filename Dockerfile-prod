# Use a base image with Java 21 installed, as specified in your pom.xml
FROM eclipse-temurin:21-jdk-jammy

# Set the working directory inside the container
WORKDIR /app

# Copy the packaged WAR file from the target directory to the container
# The JAR/WAR file name is based on the <artifactId> and <version> in pom.xml
COPY target/RolesManagement-0.0.1-SNAPSHOT.war app.war

# Expose the port the application runs on (default is 8080)
EXPOSE 8080

# Command to run the application when the container starts
ENTRYPOINT ["java", "-jar", "app.war"]
